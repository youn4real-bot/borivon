# Treat font and image files as binary — prevents git line-ending conversion from corrupting them
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text

# The D1 schema is read line by line by tests (tests/pgrestWrites.test.ts splits on "
");
# a CRLF checkout on Windows made that parse find 0 columns and fail.
d1/schema.sql text eol=lf
